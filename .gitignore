# Terraform working directory and downloaded providers
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Saved Terraform plan files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Local variable files that may contain secrets
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Temporary state lock file
.terraform.tfstate.lock.info

# Windows temporary files
Thumbs.db
Desktop.ini

# Draw.io temporary and backup files
*.bkp
*.dtmp